FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    gnuradio \
    gr-osmosdr \
    hackrf \
    libhackrf-dev \
    rtl-sdr \
    direwolf \
    libasound2-dev \
    python3 \
    python3-pip \
    python3-venv \
    python3-pyqt5 \
    python3-packaging \
    pulseaudio \
    pulseaudio-utils \
    alsa-utils \
    cmake \
    ninja-build \
    build-essential \
    git \
    curl \
    xz-utils \
    tmux \
    && rm -rf /var/lib/apt/lists/*

# ARM cross-compilation
RUN mkdir -p /opt/toolchains && \
    curl -Ls https://developer.arm.com/-/media/Files/downloads/gnu-a/10.2-2020.11/binrel/gcc-arm-10.2-2020.11-x86_64-arm-none-linux-gnueabihf.tar.xz \
    | tar -JC /opt/toolchains --strip-components=1 -x

ENV ARM_TOOLS_PATH=/opt/toolchains

# GNU Radio needs this to use POSIX shared memory instead of CreateFileMapping,
# which is unavailable inside Docker/WSL2
RUN mkdir -p /root/.gnuradio/prefs && \
    echo "vmcircbuf_default_factory=gr::vmcircbuf_sysv_shm_factory" \
    > /root/.gnuradio/prefs/vmcircbuf_default_factory

COPY fprime-amsat-reference/ /opt/fprime-amsat-reference/

RUN python3 -m venv /opt/fprime-venv && \
    . /opt/fprime-venv/bin/activate && \
    pip install fprime-tools fprime-gds && \
    pip install -r /opt/fprime-amsat-reference/lib/fprime/requirements.txt && \
    pip install -e /opt/fprime-amsat-reference/GDS

RUN . /opt/fprime-venv/bin/activate && \
    cd /opt/fprime-amsat-reference && \
    fprime-util generate arm-hf-linux && \
    fprime-util build arm-hf-linux

# The RTL-SDR Blog V4 needs the vendor librtlsdr fork -- mainline can't lock
# the R828D PLL (symptom: repeated "[R82XX] PLL not locked!"). Overwrite the
# distro library in place rather than removing the package: apt-get remove
# librtlsdr0 cascades into gr-osmosdr, which also provides osmosdr.sink for
# the HackRF.
RUN apt-get update && apt-get install -y libusb-1.0-0-dev && \
    git clone --depth 1 https://github.com/rtlsdrblog/rtl-sdr-blog /tmp/rtl-sdr-blog && \
    cmake -S /tmp/rtl-sdr-blog -B /tmp/rtl-sdr-blog/build \
      -DINSTALL_UDEV_RULES=ON \
      -DCMAKE_INSTALL_PREFIX=/usr \
      -DCMAKE_INSTALL_LIBDIR=lib/$(dpkg-architecture -qDEB_HOST_MULTIARCH) && \
    make -C /tmp/rtl-sdr-blog/build -j"$(nproc)" && \
    make -C /tmp/rtl-sdr-blog/build install && ldconfig && \
    rm -rf /tmp/rtl-sdr-blog /var/lib/apt/lists/*

# Copy local helpers last so script changes don't invalidate the build cache
COPY amsat-fprime-helpers/helpers/ /opt/amsat-fprime-helpers/helpers/
RUN chmod +x /opt/amsat-fprime-helpers/helpers/*.sh

WORKDIR /opt/amsat-fprime-helpers/helpers
CMD ["/opt/amsat-fprime-helpers/helpers/start_groundstation.sh"]
